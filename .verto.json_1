{
  "default": "quick",
  "profiles": {
    "quick": {
      "description": "Fast, deterministic — no network, skip sanitizers.",
      "args": ["--model", "rules", "--fast"]
    },
    "standard": {
      "description": "Deterministic rules, full Rung-3 sanitizer gate.",
      "args": ["--model", "rules", "--min-rung", "3"]
    },
    "thorough": {
      "description": "Heavy: metamorphic rung + more fuzzed inputs.",
      "args": ["--model", "rules", "--min-rung", "3", "--metamorphic", "--fuzz", "5000"]
    },
    "ai": {
      "description": "Local LLM proposer (needs Ollama running).",
      "args": ["--model", "local", "--candidates", "3"]
    }
  }
}
